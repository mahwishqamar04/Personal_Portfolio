## ============================================
## Database Configuration
## ============================================
## Copy this file to .env and update values for
## your environment.
##
## CREDENTIAL RESOLUTION ORDER:
##   1. Server environment variables
##   2. This .env file
##   3. Hardcoded fallbacks (local XAMPP only)
##
## LOCAL XAMPP DEFAULTS (works out of the box):
##   DB_HOST=localhost
##   DB_USER=root
##   DB_PASS=
##   DB_NAME=portfolio_db
##
## INFINITYFREE (fill in from VistaPanel):
##   1. Create a MySQL database in VistaPanel.
##   2. Copy the assigned values below.
##   DB_HOST=sqlXXX.infinity-free.com
##   DB_USER=if0_XXXXXXXX
##   DB_PASS=your_mysql_password
##   DB_NAME=if0_XXXXXXXX_portfolio
## ============================================

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=portfolio_db
